{
  "name": "@nl-design-system/index",
  "description": "Design system based on the NL Design System architecture",
  "author": "Community for NL Design System",
  "license": "EUPL-1.2",
  "keywords": [
    "nl-design-system"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "github:nl-design-system/index",
    "directory": "packages/component-progress"
  },
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "engines": {
    "//": "Update @types/node to match the highest node version here",
    "node": ">=24 <=25",
    "pnpm": "^11.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.6",
    "@babel/plugin-syntax-import-attributes": "7.29.7",
    "@eslint/js": "9.39.2",
    "@eslint/json": "0.14.0",
    "@changesets/cli": "3.0.1",
    "@nl-design-system/eslint-config": "2.4.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "markdownlint-cli": "0.49.1",
    "npm-check-updates": "22.2.9",
    "npm-package-json-lint": "9.1.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "scripts": {
    "build": "pnpm run --recursive --aggregate-output build",
    "clean": "pnpm run --recursive --aggregate-output --parallel clean",
    "lint": "pnpm run --sequential '/^lint:(js|md|package-json|prettier)$/'",
    "lint:js": "eslint",
    "lint:md": "markdownlint '**/*.md'",
    "lint:package-json": "npmPkgJsonLint '**/package.json'",
    "lint:prettier": "prettier --check .",
    "lint-fix": "pnpm run --sequential '/^lint-fix:(js|md|prettier)$/'",
    "lint-fix:js": "eslint --fix",
    "lint-fix:md": "markdownlint --fix '**/*.md'",
    "lint-fix:prettier": "prettier --write .",
    "prepare": "husky",
    "changeset": "changeset add",
    "changeset:empty": "changeset add --empty",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since origin/main",
    "update-patch": "npm-check-updates --configFileName .ncurc.patch.mjs",
    "update-minor": "npm-check-updates --configFileName .ncurc.minor.mjs",
    "update-major": "npm-check-updates --configFileName .ncurc.major.mjs"
  }
}
